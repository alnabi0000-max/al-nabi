# =============================================================================
# Al-Nabi — Core Environment
# Copy:  copy .env.example .env.local
# Currency: NC (Nabi Credits) · Engine: Al-Nabi Native Engine (white-label)
# =============================================================================

# ── 0. Database — Prisma / PostgreSQL (Supabase) — REQUIRED ───────────────────
# https://supabase.com/dashboard/project/_/settings/database
# DATABASE_URL = pooled connection (port 6543, pgbouncer) — used at runtime
# DIRECT_URL   = direct connection (port 5432) — used for `prisma migrate`
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ── 1. OpenRouter — ALL LLM text tasks (single key) ───────────────────────────
# Prompt enhance · Producer Chat · Script · Model-watcher drafts
# https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-..."
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_ENHANCE_MODEL="anthropic/claude-3.5-sonnet"
OPENROUTER_WATCHER_MODEL="openai/gpt-4o-mini"
OPENROUTER_VISION_MODEL="openai/gpt-4o"

# ── 2. Video / Image API (server-side only · white-labeled) ───────────────────
# Exposed to users as "Al-Nabi Native Engine" — never call from the browser.
# https://replicate.com/account/api-tokens
REPLICATE_API_KEY="r8_..."
# Optional model overrides (defaults are the current flagships):
# REPLICATE_FLUX_MODEL="black-forest-labs/flux-2-pro"
# REPLICATE_KLING_V3_MODEL="kwaivgi/kling-v3-video"
# REPLICATE_KLING_V25_MODEL="kwaivgi/kling-v2.5-turbo-pro"
# REPLICATE_RUNWAY_MODEL="kwaivgi/kling-v2.6"
# REPLICATE_WAN_MODEL="wan-video/wan-2.2-t2v-fast"
# REPLICATE_MINIMAX_MODEL="minimax/hailuo-02"
# Cost protection: leave unset for ONE video API call per generation
# VIDEO_ALLOW_FALLBACK="1"

# ── 3. Voice / TTS (Al-Nabi Audio Engine) ─────────────────────────────────────
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=""
# ELEVENLABS_VOICE_ID=""
# Highest-quality multilingual TTS (falls back to eleven_multilingual_v2).
# ELEVENLABS_MODEL="eleven_v3"

# ── Admin · Model updater · Telegram alerts ───────────────────────────────────
ADMIN_API_SECRET="change-me-long-secret"
CRON_SECRET="change-me-cron-secret"
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
# Hidden /admin gate. Hashed into Postgres on first successful unlock.
# After that, rotate it from the in-panel Security & Settings page.
# Minimum 8 characters. Do not use a placeholder like "change-me".
# ADMIN_MASTER_PASSCODE=""
# Optional AES key for the encrypted admin-gate cookie (falls back to AUTH_SECRET).
# ADMIN_GATE_SECRET=""
# MODEL_WATCH_DEMO="1"  # force a pending update for /admin UI testing
# Cron: GET/POST /api/cron/model-watch  (Bearer CRON_SECRET)
# Vercel: vercel.json schedules every 12h · or use Inngest modelWatchFn

# ── Inngest (background jobs · REQUIRED in production) ───────────────────────
# Both values are required before production generations are accepted.
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""
# Development only: route work to a local Inngest dev server.
# INNGEST_DEV="1"

# ── Cloud Vault object storage (REQUIRED in production) ──────────────────────
# Production never writes completed media to STORAGE_DIR. Configure one full
# R2 or S3 credential set; R2_PUBLIC_URL is optional when signed URLs are used.
# STORAGE_DIR="./storage"
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# R2_PUBLIC_URL=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""
# AWS_S3_BUCKET=""
# AWS_S3_PUBLIC_URL=""
# Cloud Vault re-download after first unlock: 5 NC

# ── Auth — Supabase ───────────────────────────────────────────────────────────
# Enable these providers in Supabase → Authentication → Providers:
#   Google  — one-click web + native sign-in
#   Apple   — mandatory for iOS App Store review
#   Email   — magic link AND 6-digit code (add {{ .Token }} to the Magic Link
#             email template so /api/auth/otp/send can deliver a code)
# Redirect URLs (Authentication → URL Configuration) must include:
#   https://<your-domain>/auth/callback
#   alnabi://auth/callback            (native deep link, PKCE)
# Local development (`NODE_ENV=development`) MAY use placeholder / mock values.
# Production (`NODE_ENV=production` runtime, and CI/Vercel builds) fail-closes
# if these are missing, empty, or still look like placeholders.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Optional: lets the Edge middleware reject forged/expired bearer tokens before
# they reach a route handler. Supabase → Settings → API → JWT Secret.
# Without it the middleware still enforces expiry and the route handler still
# verifies every token against Supabase Auth.
# SUPABASE_JWT_SECRET=""

# Custom URL scheme registered by the iOS/Android build (deep link callback).
# NEXT_PUBLIC_MOBILE_URL_SCHEME="alnabi"

# Local session cookie signing (HMAC) — REQUIRED in production, 32+ random chars.
# Generate: openssl rand -base64 32
AUTH_SECRET="change-me-32-char-minimum-random-secret"
# AUTH_MODE="local"                 # force local/guest auth (dev/self-host only — NEVER "local" in prod)
# NEXT_PUBLIC_AUTH_MODE="local"     # client-side mirror of AUTH_MODE

# Verifies POST /api/webhooks/supabase (auth.users triggers), if used.
# SUPABASE_WEBHOOK_SECRET=""

# ── Payments — Stripe (NC packs) ──────────────────────────────────────────────
# Local development (`NODE_ENV=development`) may keep these as placeholders.
# Production runtime fail-closes if STRIPE_SECRET_KEY / webhook secret are missing.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Rate limiting — Upstash Redis (REQUIRED in production) ───────────────────
# Production API requests fail closed if these are absent or unreachable.
# https://console.upstash.com
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# ── Error monitoring — Sentry (optional but recommended in prod) ─────────────
# https://sentry.io
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_DSN=""
# SENTRY_ORG=""
# SENTRY_PROJECT=""

# ── Transactional email — Resend (welcome email, optional) ────────────────────
# https://resend.com/api-keys
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="Alnabiy <onboarding@alnabiy.app>"

# ── Local session / obfuscation secrets — REQUIRED in production ──────────────
# Encrypts short-lived tokens (media signing, etc). Generate a long random value.
ALNABIY_OBFUSCATE_SECRET="change-me-long-random-secret"

# ── Safety flags — leave unset in production; only for local/self-host testing ─
# ALLOW_DEMO_CHECKOUT="1"           # allow free-coin demo checkout without Stripe
# ALLOW_SOFT_CREDITS="1"            # allow client-reported balance fallback
# ALNABIY_DEV_AUTH_BYPASS="1"       # auto-create a guest ledger account
# ALNABIY_FORCE_MOCK="1"            # force instant mock generation (never in prod)
# ALNABIY_ALLOW_AUDIO_MOCK="1"      # allow silent mock voiceover without ElevenLabs

# ── FFmpeg media runtime ──────────────────────────────────────────────────────
# Set only on a self-hosted/worker runtime that has ffmpeg with libx264 + AAC.
# Script-to-movie and producer rendering return 503 until this is enabled and
# the startup capability check passes. BGM/frame extraction stays feature-gated.
# ALNABIY_FFMPEG_ENABLED="1"
